# ──────────────────────────────────────────────
# FlyRank Backend — Environment Variables
# Copy to .env and fill in. NEVER commit real secrets.
# ──────────────────────────────────────────────

# ── Database (Postgres via Docker) ──
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=flyrank_dev
POSTGRES_DB=flyrank
DATABASE_URL=postgresql+psycopg2://flyrank:flyrank_dev@localhost:5432/flyrank

# ── Security ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──
# Comma-separated list of allowed origins for the dashboard API.
# The public submission endpoint uses a separate, widget-specific CORS policy.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PUBLIC_PER_MINUTE=10

# ── Geo Enrichment (free providers) ──
# ip-api.com free tier: 45 req/min, no key required
GEO_PROVIDER_PRIMARY=ip-api
# ipinfo.io free tier: 50k req/month, token optional
GEO_PROVIDER_FALLBACK=ipinfo
GEO_FALLBACK_TOKEN=

# ── Email (Mailpit for local dev) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@flyrank.local

# ── Webhook (optional, per-tenant) ──
WEBHOOK_TIMEOUT_SECONDS=5

# ── Environment ──
ENVIRONMENT=development
